{
  "name": "homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gate": "node local/tools/gates/run.mjs",
    "typecheck": "tsc --noEmit",
    "cli:build": "vite build --config packages/cli/vite.config.ts",
    "cli": "npm run cli:build && node packages/cli/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
